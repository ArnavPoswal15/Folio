# GROQ_API_KEY: Primary fast speech-to-text API key (https://console.groq.com).
# Used by /api/transcribe with whisper-large-v3-turbo when set.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Fallback Gemini transcription API key (auto-injected in AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional transcription protection overrides (safe defaults are built in)
# FIREBASE_PROJECT_ID="sound-jet-6v0ns"
# TRANSCRIBE_IP_RATE_LIMIT_PER_MIN="15"
# TRANSCRIBE_USER_RATE_LIMIT_PER_MIN="8"
# TRANSCRIBE_USER_DAILY_REQUESTS="60"
# TRANSCRIBE_USER_DAILY_AUDIO_SECONDS="900"
# TRANSCRIBE_GLOBAL_DAILY_REQUESTS="1000"
# TRANSCRIBE_MAX_AUDIO_SECONDS="185"
