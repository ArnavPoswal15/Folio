rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default-deny everything unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSpread(data, userId, spreadId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'date',
          'contextNote',
          'leftBody',
          'rightBody',
          'leftInk',
          'rightInk',
          'inkColor',
          'paperStyle',
          'clientUpdatedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'date',
          'contextNote',
          'leftBody',
          'rightBody',
          'leftInk',
          'rightInk',
          'inkColor',
          'paperStyle',
          'clientUpdatedAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == spreadId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.contextNote is string
        && data.contextNote.size() <= 240
        && data.leftBody is string
        && data.leftBody.size() <= 20000
        && data.rightBody is string
        && data.rightBody.size() <= 20000
        && data.leftInk is string
        && data.leftInk.size() <= 160000
        && data.rightInk is string
        && data.rightInk.size() <= 160000
        && data.inkColor in ['charcoal', 'midnight', 'sepia']
        && data.paperStyle in ['ruled', 'dotted', 'blank']
        && (data.clientUpdatedAt is int || data.clientUpdatedAt is float)
        && data.clientUpdatedAt >= 0
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId)
        && isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      match /spreads/{spreadId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId)
          && isValidId(spreadId)
          && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isVerified()
          && isValidId(spreadId)
          && isValidSpread(incoming(), userId, spreadId)
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isVerified()
          && isValidId(spreadId)
          && isValidSpread(incoming(), userId, spreadId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date',
            'contextNote',
            'leftBody',
            'rightBody',
            'leftInk',
            'rightInk',
            'inkColor',
            'paperStyle',
            'clientUpdatedAt',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId)
          && isValidId(spreadId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
